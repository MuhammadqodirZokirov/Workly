# --- umumiy ---
# dev | staging | prod (prod'da namuna qiymatlar bilan ishga tushmaydi)
ENV=dev
# Server: web ilova, API va bot webhook bitta domenda (Caddy HTTPS'ni o'zi oladi)
DOMAIN=app.example.uz
ACME_EMAIL=admin@example.uz
# Web ilovadagi "Telegram orqali kirish" tugmasi
VITE_BOT_URL=https://t.me/workly_bot
BACKUP_KEEP_DAYS=14
JWT_SECRET=almashtiring-kamida-32-belgili-tasodifiy-satr

# --- shaxsiy ma'lumotlar (TZ 19) ---
# Fernet kaliti: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DIQQAT: kalit yo'qolsa, shifrlangan hujjatlar va fayllarni ochib bo'lmaydi — xavfsiz joyda zaxiralang
DATA_ENCRYPTION_KEY=
# Hujjat raqami hash'i uchun tasodifiy satr (o'zgartirilsa takrorni topish ishlamay qoladi)
DATA_HASH_KEY=
MEDIA_DIR=./media
MAX_UPLOAD_MB=5

# --- baza (docker compose) ---
POSTGRES_USER=workly
POSTGRES_PASSWORD=almashtiring
POSTGRES_DB=workly
# Docker'siz lokal ishga tushirishda:
DATABASE_URL=postgresql+asyncpg://workly:almashtiring@localhost:5432/workly
REDIS_URL=redis://localhost:6379/0

# --- Telegram ---
BOT_TOKEN=123456789:AAA...
# polling (dev) | webhook (prod) | off
BOT_MODE=polling
# webhook rejimida:
PUBLIC_BASE_URL=https://api.example.uz
BOT_WEBHOOK_SECRET=almashtiring
# Mini App manzili (https bo'lishi shart)
WEBAPP_URL=https://app.example.uz
# Signallar qo'shimcha oluvchilari (JSON ro'yxat); asosiy oluvchilar — bazada xodim roli bor Telegram ID'lar
ADMINS=[123456789]
# Alohida admin bot (BotFather'da yangi bot): kategoriya, narx, hudud, signallar. Bo'sh — signallar asosiy botdan
ADMIN_BOT_TOKEN=
# Ko'p kunlik buyurtma (har kun alohida check-in hali yo'q) — pilotda false
MULTI_DAY_ENABLED=false

# --- SMS ---
# console (kod logga yoziladi) | eskiz
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

CORS_ORIGINS=["http://localhost:5173"]
