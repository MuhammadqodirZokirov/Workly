{
	# Let's Encrypt ogohlantirishlari shu manzilga (sertifikat muddati va h.k.)
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
		-Server
	}

	# API, bot webhook va health — backend'ga
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}

	# Build fayllari nomida hash bor — uzoq keshlash mumkin
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# SPA: noma'lum yo'llar index.html ga (React Router)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
